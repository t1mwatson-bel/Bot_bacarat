# ============================================
# ТЕЛЕГРАМ НАСТРОЙКИ (обязательно заполнить!)
# ============================================
# Получить токен: @BotFather в Telegram
BOT_TOKEN=5482422004:AAHXLYyZ-qoCsycse1k9Qt6YRi9jmB24B-k

# ID каналов (получить: @getidsbot)
INPUT_CHANNEL_ID=-1003469691743   # Откуда читаем игры
OUTPUT_CHANNEL_ID=-1003855079501  # Куда постим прогнозы

# ============================================
# НАСТРОЙКИ ПРОГНОЗОВ (можно менять под себя)
# ============================================
# Сколько максимум активных прогнозов (рекомендую 2-3)
MAX_ACTIVE_PREDICTIONS=2

# Сколько в очереди может ждать (рекомендую 3-5)
MAX_PENDING_PREDICTIONS=3

# Через сколько прогноз считается зависшим (секунд)
# 7200 = 2 часа
PREDICTION_TIMEOUT=7200

# Максимум прогнозов в час (рекомендую 4-6)
MAX_PREDICTIONS_PER_HOUR=6

# Минимум между прогнозами (секунд, 180 = 3 минуты)
MIN_TIME_BETWEEN_PREDICTIONS=180

# ============================================
# НАСТРОЙКИ ML МОДЕЛЕЙ
# ============================================
# Размер истории для обучения (рекомендую 500-2000)
ML_HISTORY_SIZE=1000

# Минимальная уверенность для прогноза (0.0 - 1.0)
# 0.5 = 50%
MIN_CONFIDENCE=0.5

# Динамический порог уверенности (true/false)
DYNAMIC_THRESHOLD=true

# ============================================
# АНАЛИЗ И СТРАТЕГИИ (включать/выключать фичи)
# ============================================
# Анализировать историю игр?
ENABLE_HISTORY_ANALYSIS=true

# Использовать умные догоны?
ENABLE_SMART_DOGONS=true

# Отслеживать аномалии?
ENABLE_ANOMALY_DETECTION=true

# Проверять сомнительные масти?
ENABLE_SUIT_ANALYSIS=true

# ============================================
# НАСТРОЙКИ ДОГОНОВ
# ============================================
# Стратегия по умолчанию: normal, aggressive, conservative
DEFAULT_DOGON_STRATEGY=normal

# Интервалы для мастей (через запятую)
SUIT_DOGON_INTERVALS=1,2,3

# Интервалы для значений (через запятую)
VALUE_DOGON_INTERVALS=2,3,5

# ============================================
# НАСТРОЙКИ ЛОГИРОВАНИЯ
# ============================================
# Уровень: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Формат: json или text
LOG_FORMAT=json

# Сохранять логи в файл?
LOG_TO_FILE=true

# ============================================
# ПУТИ К ФАЙЛАМ (обычно не трогать)
# ============================================
MODELS_DIR=ml_models
HISTORY_FILE=ml_history.json
PATTERNS_FILE=dangerous_patterns.json
LOG_FILE=logs/bot.log